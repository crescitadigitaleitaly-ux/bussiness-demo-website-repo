# Public URL of the deployed site (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp destination in international format, digits only (e.g. 393331234567).
# Leave the placeholder until the client supplies an approved number.
NEXT_PUBLIC_WHATSAPP_NUMBER=390000000000

# Optional: real form delivery (see README > Connecting the form)
# RESEND_API_KEY=
# BOOKING_INBOX=

# Optional: the restaurant's own TheFork page (defaults to the TheFork home page in the demo)
# NEXT_PUBLIC_THEFORK_URL=

# Admin panel (/admin). Create the hash and secret with: node scripts/hash-password.mjs "a long password"
# ADMIN_EMAIL=
# ADMIN_PASSWORD_HASH=
# ADMIN_SESSION_SECRET=
# Where saves go: "file" (development) or "github" (production on Vercel). Unset in production = saving off.
# CMS_STORAGE=github
# CMS_GITHUB_TOKEN=            # fine-grained token: Contents read/write on this repo only
# CMS_GITHUB_REPO=owner/repo
# CMS_GITHUB_BRANCH=main
# CMS_GITHUB_DIR=04-restaurant/src/content/cms
