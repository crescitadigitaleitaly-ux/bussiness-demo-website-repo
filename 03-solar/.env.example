# Public URL of the deployed site (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp destination in international format, digits only (e.g. 393331234567).
# Leave the placeholder until the client supplies an approved number.
NEXT_PUBLIC_WHATSAPP_NUMBER=390000000000

# Real form delivery through the Supabase Edge Function "solar-quote" (supabase/functions/solar-quote).
# Leave empty to keep the forms in demo mode. The anon key is Supabase's public key.
# QUOTE_FUNCTION_URL=https://<project-ref>.supabase.co/functions/v1/solar-quote
# SUPABASE_ANON_KEY=
