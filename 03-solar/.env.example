# Public URL of the deployed site (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp destination in international format, digits only (e.g. 393331234567).
# Leave the placeholder until the client supplies an approved number.
NEXT_PUBLIC_WHATSAPP_NUMBER=390000000000

# Optional: real form delivery (see README > Connecting the form)
# RESEND_API_KEY=
# QUOTE_INBOX=
